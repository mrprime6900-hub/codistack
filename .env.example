# --- Database (server-only; never expose to the browser) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Signing secret: random string, 32+ chars (signs form tokens, admin sessions, IP hashes) ---
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# --- Admin area (disabled until ALL THREE of ADMIN_EMAIL, ADMIN_PASSWORD_HASH, APP_SECRET are set) ---
ADMIN_EMAIL=
# Generate with: node scripts/hash-password.mjs "your-long-unique-password"
ADMIN_PASSWORD_HASH=

# --- Public site URL: set ONLY once the real domain is confirmed (enables canonical/sitemap/JSON-LD URL) ---
NEXT_PUBLIC_SITE_URL=
